{
  "name": "playwright-ecommerce-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test automation framework for an e-commerce store: UI (Page Object + fixtures) and API tests with schema validation",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "api-testing",
    "page-object",
    "e-commerce"
  ],
  "author": "Ivan Saitarly",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.10.0",
    "dotenv": "^17.2.3",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "zod": "^4.6.7"
  }
}
